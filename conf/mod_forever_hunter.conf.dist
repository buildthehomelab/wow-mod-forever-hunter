[worldserver]

########################################
# mod-forever-hunter
#
# Hunter changes. For now, Season of Discovery-style pet scaling on top of AzerothCore's own:
# hunter pets also get the hunter's crit and haste, more maximum focus, and physical pet
# abilities get more from attack power. Changes apply to pets within 2 seconds of a config
# reload.
########################################

#
#    ForeverHunter.PetScaling.Enable
#        Description: Master switch. With 0, pets lose the bonuses within 2 seconds.
#        Default:     1
#

ForeverHunter.PetScaling.Enable = 1

#
#    ForeverHunter.PetScaling.CritPercent
#        Description: Share of the hunter's ranged crit chance the pet gets, in percent, on top
#                     of its own 5%. With 100, a hunter at 30% ranged crit gives the pet +30%, so
#                     35% before talents. Rounded to whole percents.
#        Default:     100
#

ForeverHunter.PetScaling.CritPercent = 100

#
#    ForeverHunter.PetScaling.HastePercent
#        Description: Share of the hunter's ranged haste the pet gets as attack speed, in percent.
#                     Rounded to whole percents.
#        Default:     100
#

ForeverHunter.PetScaling.HastePercent = 100

#
#    ForeverHunter.PetScaling.HasteSource
#        Description: Which ranged haste counts.
#                     0 - Haste rating only.
#                     1 - Everything that speeds up the hunter's ranged attacks: haste rating,
#                         quiver and ammo pouch, Rapid Fire, Improved Aspect of the Hawk, Serpent's
#                         Swiftness and so on. Much stronger: the quiver alone adds about 15%, and
#                         Serpent's Swiftness, which already speeds up the pet, counts twice.
#        Default:     0
#

ForeverHunter.PetScaling.HasteSource = 0

#
#    ForeverHunter.PetScaling.FocusBonus
#        Description: Extra maximum focus for the pet, on top of its normal 100. SoD gives 51.
#                     0 for none.
#        Default:     51
#

ForeverHunter.PetScaling.FocusBonus = 51

#
#    ForeverHunter.PetScaling.PhysicalAbilityAPMultiplier
#        Description: Multiplies how much the pet's physical abilities (Claw, Bite, Smack, Gore,
#                     Monstrous Bite, Swipe, Snatch, Savage Rend, Ravage, Rake's first hit and
#                     Demoralizing Screech) get from the pet's attack power. Stock 3.3.5 gives
#                     them 7% of it, about 1.5% of the hunter's ranged attack power; magic pet
#                     abilities like Lightning Breath get about 4.3%. With 2.0 the physical ones
#                     get 14%, about 3.1%; about 2.8 makes them equal. 1.0 changes nothing.
#                     Only hunter pets are affected, not NPCs using the same spells.
#        Default:     2.0
#

ForeverHunter.PetScaling.PhysicalAbilityAPMultiplier = 2.0

########################################
# Lone Wolf
#
# WoW Forever's Marksmanship talent: 20% more damage while you don't have a pet out. Without a
# client patch it can't be a talent you pick, so every Marksmanship hunter gets it. Players see
# it as a "Frenzy" buff.
########################################

#
#    ForeverHunter.LoneWolf.Enable
#        Description: Master switch. With 0, hunters lose the bonus and the buff within a
#                     second.
#        Default:     1
#

ForeverHunter.LoneWolf.Enable = 1

#
#    ForeverHunter.LoneWolf.DamagePercent
#        Description: Extra damage, in percent, for all of the hunter's damage: shots, melee,
#                     stings and traps. The buff's tooltip always says 20%, whatever this is set
#                     to: the text comes from the client.
#        Default:     20
#

ForeverHunter.LoneWolf.DamagePercent = 20

#
#    ForeverHunter.LoneWolf.MarksmanshipPoints
#        Description: Talent points in Marksmanship, in the active spec, needed for Lone Wolf.
#                     WoW Forever's talent needs 10 to pick. 0 gives it to every hunter.
#        Default:     10
#

ForeverHunter.LoneWolf.MarksmanshipPoints = 10

#
#    ForeverHunter.LoneWolf.RequireMainTree
#        Description: 1: Marksmanship must also be the tree with the most points, so only
#                     Marksmanship hunters get it, not a Beast Mastery or Survival hunter with 10
#                     points in Marksmanship. 0: the points are enough.
#        Default:     1
#

ForeverHunter.LoneWolf.RequireMainTree = 1

########################################
# Summon Hawk
#
# WoW Forever's Beast Mastery talent: send a hawk at your target that attacks it for 18 seconds,
# up to 2 at once, on a 6 second cooldown shared with Arcane Shot. Without a client patch it
# can't be a talent you pick, so every Beast Mastery hunter learns it. The button is "Swoop",
# a spell the client already has: its tooltip talks about swooping down on your target and a
# fixed amount of damage, but it sends a hawk.
########################################

#
#    ForeverHunter.SummonHawk.Enable
#        Description: Master switch. With 0, hunters lose Summon Hawk within a second; hawks
#                     already out stay until they expire.
#        Default:     1
#

ForeverHunter.SummonHawk.Enable = 1

#
#    ForeverHunter.SummonHawk.BeastMasteryPoints
#    ForeverHunter.SummonHawk.RequireMainTree
#        Description: Talent points in Beast Mastery, in the active spec, needed to have Summon
#                     Hawk (WoW Forever's talent needs 15), and whether Beast Mastery must also be
#                     the tree with the most points (1) or the points are enough (0).
#        Default:     15, 1
#

ForeverHunter.SummonHawk.BeastMasteryPoints = 15
ForeverHunter.SummonHawk.RequireMainTree = 1

#
#    ForeverHunter.SummonHawk.Duration
#    ForeverHunter.SummonHawk.Cooldown
#        Description: How long a hawk stays, and the cooldown shared with Arcane Shot, in
#                     milliseconds. Cooldown 0 unlinks them and removes the cooldown.
#        Default:     18000, 6000
#

ForeverHunter.SummonHawk.Duration = 18000
ForeverHunter.SummonHawk.Cooldown = 6000

#
#    ForeverHunter.SummonHawk.MaxActive
#        Description: Hawks a hunter can have out at once. Another one replaces the hawk with the
#                     least time left.
#        Default:     2
#

ForeverHunter.SummonHawk.MaxActive = 2

#
#    ForeverHunter.SummonHawk.ManaCostPercent
#        Description: Mana cost as a whole percentage of base mana, like Arcane Shot's 5%. The
#                     client shows no cost on the button.
#        Default:     5
#

ForeverHunter.SummonHawk.ManaCostPercent = 5

#
#    ForeverHunter.SummonHawk.AttackPowerPercent
#        Description: Share of the hunter's ranged attack power each hawk gets as attack power,
#                     fixed when it's summoned. Hunter pets get 22%, Feral Spirit wolves about
#                     30%. WoW Forever doesn't publish its number.
#        Default:     30
#

ForeverHunter.SummonHawk.AttackPowerPercent = 30
